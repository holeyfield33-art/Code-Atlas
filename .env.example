# Copy to .env (git-ignored) and fill in. `scripts/atlas.ps1 key` / `scripts/atlas.sh key`
# does this for you. Placeholder values only - never commit a real key.

# Required for the MCP HTTP service: a random secret, 32+ characters.
ATLAS_MCP_API_KEY=replace-with-64-random-hex-characters

# Optional: set to 1 to ALSO accept the key inside the URL (/mcp?key=...). Only for a
# client that cannot send a header, such as a tunnel client. Off by default; see
# docs/mcp-setup.md ("ChatGPT").
# ATLAS_ALLOW_URL_KEY=1

# Optional: change the published ports (host and container use the same number).
# ATLAS_APP_PORT=4173
# ATLAS_MCP_PORT=8000

# Optional: the source tree `docker compose run --rm build` scans (default: this folder).
# ATLAS_SRC=C:/path/to/your/project
